## Test Scenarios

### Parser Tests

**Valid JSON**:
```typescript
it('should parse valid JSON response', () => {
  const json = `{
    "title": "New Java Framework",
    "impact": "Improves performance",
    "keyPoints": ["Point 1", "Point 2", "Point 3"],
    "action": "Upgrade to v2"
  }`;
  const result = parseAISummary(json);
  expect(result.title).toBe("New Java Framework");
  expect(result.keyPoints.length).toBe(3);
});
```

**Markdown wrapper**:
```typescript
it('should extract JSON from markdown wrapper', () => {
  const json = `Here's the summary:\n\`\`\`json\n{"title":"...","impact":"...","keyPoints":["a","b","c"],"action":"..."}\n\`\`\``;
  const result = parseAISummary(json);
  expect(result.title).toBeTruthy();
});
```

**Validation errors**:
```typescript
it('should reject title > 50 chars', () => {
  const summary = {
    title: 'x'.repeat(51),
    impact: 'Important',
    keyPoints: ['a', 'b', 'c'],
    action: 'Do this'
  };
  expect(() => validateAISummary(summary)).toThrow('Title must be 1-50 characters');
});

it('should reject keyPoints with 2 items', () => {
  const summary = {
    title: 'Title',
    impact: 'Important',
    keyPoints: ['a', 'b'],
    action: 'Do this'
  };
  expect(() => validateAISummary(summary)).toThrow('exactly 3 items');
});
```

### Renderer Tests

**Color injection**:
```typescript
it('should inject domain color into HTML', () => {
  const metadata: EmailMetadata = {
    domain: 'Java',
    domainColor: '#FF6B6B',
    subject: 'Test',
    from: 'test@example.com',
    date: new Date('2025-12-14'),
    contentCleaned: 'content'
  };
  const summary: AISummary = {
    title: 'Title',
    impact: 'Impact',
    keyPoints: ['a', 'b', 'c'],
    action: 'Action'
  };
  const html = renderOutputEmail(metadata, summary);
  expect(html).toContain('#FF6B6B');
  expect(html).toContain('#FF6B6B20'); // With opacity
});
```

**Emoji markers**:
```typescript
it('should include emoji markers', () => {
  const html = renderOutputEmail(metadata, summary);
  expect(html).toContain('💡');
  expect(html).toContain('📌');
  expect(html).toContain('🎯');
});
```

**HTML escaping**:
```typescript
it('should escape HTML special characters', () => {
  const summary: AISummary = {
    title: '<script>alert("xss")</script>',
    impact: 'Impact & more',
    keyPoints: ['Point "1"', 'Point \'2\'', 'Point <3>'],
    action: 'Action'
  };
  const html = renderOutputEmail(metadata, summary);
  expect(html).not.toContain('<script>');
  expect(html).toContain('&lt;script&gt;');
  expect(html).toContain('&amp;');
  expect(html).toContain('&quot;');
});
```

