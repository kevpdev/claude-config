{
  "$schema": "./agent-routing.schema.json",
  "_schema_version": 1,
  "_comment": "Routage déterministe des agents/skills sur UserPromptSubmit. Toutes les règles qui matchent sont collectées (menu multi-skill) ; force=true → requis, force=false → suggéré. Voir core/docs/AGENT-ROUTING.md.",
  "rules": [
    {
      "id": "doc-generation",
      "match": { "regex": "documente|javadoc|jsdoc|readme|openapi|swagger|commente le code|commente cette (m[eé]thode|fonction|classe)|doc technique|mise.?[aà].?jour.*doc" },
      "target": { "type": "agent", "name": "doc-writer" },
      "force": true,
      "reason": "Génération de documentation — déléguer systématiquement au sous-agent doc-writer (cf. CLAUDE.md global)."
    },
    {
      "id": "security-audit",
      "match": { "regex": "owasp|\\bxss\\b|\\bcsrf\\b|\\bjwt\\b|\\bcve-|vuln[eé]rabilit|faille|audit.{0,20}s[eé]cu|injection (sql|de code|de commande|xss)|secret.{0,15}(expos|en dur|hardcod|fuit|leak)|cl[eé].{0,10}api.{0,10}(expos|en dur)" },
      "target": { "type": "skill", "name": "security-reviewer" },
      "force": false,
      "reason": "Audit sécurité — skill security-reviewer recommandé avant tout déploiement sensible."
    },
    {
      "id": "database-expertise",
      "match": { "regex": "\\b(database|sgbd|nosql|postgres(ql)?|mysql|mariadb|mongo(db)?|redis|pgvector|sqlite)\\b|\\bsql\\b|requ[eê]te lente|slow query|explain analyze|migration de (base|donn[eé]es|sch[eé]ma)|index (gin|gist|hnsw|b-?tree|composite|partiel)" },
      "target": { "type": "skill", "name": "database-expert" },
      "force": false,
      "reason": "Tâche base de données — skill database-expert recommandé pour migrations/index/perf."
    },
    {
      "id": "frontend-expertise",
      "match": { "regex": "frontend|react|vue|angular|next|nuxt|ssr|csr|a11y|accessib|composant|component|web vital|render|hydration" },
      "target": { "type": "skill", "name": "frontend-expert" },
      "force": false,
      "reason": "Tâche frontend — skill frontend-expert recommandé pour SSR/CSR, perf, a11y."
    },
    {
      "id": "agentic-architecture",
      "match": { "regex": "agenti|multi.?agent|orchestrat|sous.?agent|a2a|d[eé]l[eé]gation.*agent|workflow.*agent|agent.*workflow|mcp.*script|hook.*llm|llm.*hook|context.*window.*agent|agent.*autonome" },
      "target": { "type": "skill", "name": "agentic-architect" },
      "force": false,
      "reason": "Architecture agentique — skill agentic-architect recommandé pour les décisions d'orchestration et de routing multi-agent."
    },
    {
      "id": "backend-architecture",
      "match": { "regex": "architect|api|rest|graphql|grpc|microserv|monolith|backend|design pattern|ddd|cqrs|hexagonal" },
      "target": { "type": "skill", "name": "backend-architect" },
      "force": false,
      "reason": "Décision d'architecture backend — skill backend-architect recommandé pour les trade-offs."
    },
    {
      "id": "devops",
      "match": { "regex": "ci.?cd|pipeline|gitlab.?ci|github.?action|dockerfile|docker.?build|docker.?image|kubernetes|k8s|helm|terraform|ansible|infra.*as.*code|\\biac\\b|blue.?green|canary|rollback|deploy|observabilit|prometheus|grafana|\\bsre\\b|gitops|container.?registry|devops" },
      "target": { "type": "skill", "name": "devops-expert" },
      "force": false,
      "reason": "Tâche DevOps — skill devops-expert recommandé pour CI/CD, Docker, K8s et bonnes pratiques infra."
    },
    {
      "id": "code-review",
      "match": { "regex": "review|relire|valide ce code|qualit|lisibilit|solid|mainten|refactor|propre|clean code" },
      "target": { "type": "skill", "name": "code-reviewer" },
      "force": false,
      "reason": "Review qualité — charger le skill code-reviewer pour appliquer la grille SOLID + lisibilité."
    }
  ]
}
