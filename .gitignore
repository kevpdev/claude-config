# Claude Code - .gitignore

# Plans (temporary planning files)
plans/

# Memory Bank - Global template (ignore in global .claude)
# Each project has its own memory-bank/ (fully versioned in projects)
memory-bank/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Node modules (if any scripts use them)
node_modules/

# Environment files (if any)
.env
.env.local
.env.*.local

# Credentials (OAuth tokens)
.credentials.json

# Cache directories
.cache/

# Claude Code runtime files
debug/
file-history/
projects/
shell-snapshots/
todos/
ide/*.lock
stats-cache.json
statsig/
history.jsonl

# Plugins (keep installed_plugins.json, ignore caches)
plugins/known_marketplaces.json
plugins/marketplaces/
